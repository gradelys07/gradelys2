# ═══════════════════════════════════════════════════════════════
# GRADELYS v2.0 — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your own keys.
# The app runs in DEMO MODE automatically for any integration
# whose keys are left empty (see src/lib/config.ts).
# ═══════════════════════════════════════════════════════════════

# ── SUPABASE (auth, database, storage) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── GOOGLE / GEMINI (AI chat, vision, generation) ───────────────
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── WHOP (payments — subscriptions + one-time packs) ────────────
WHOP_API_KEY=
WHOP_CLIENT_ID=
WHOP_CLIENT_SECRET=
WHOP_WEBHOOK_SECRET=
NEXT_PUBLIC_WHOP_CHECKOUT_PLUS_MONTHLY=
NEXT_PUBLIC_WHOP_CHECKOUT_PLUS_ANNUAL=
NEXT_PUBLIC_WHOP_CHECKOUT_PRO_MONTHLY=
NEXT_PUBLIC_WHOP_CHECKOUT_PRO_ANNUAL=
NEXT_PUBLIC_WHOP_CHECKOUT_RECHARGE_50=
NEXT_PUBLIC_WHOP_CHECKOUT_RECHARGE_200=
NEXT_PUBLIC_WHOP_CHECKOUT_RECHARGE_UNLIMITED=

# ── RESEND (transactional emails) ───────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@gradelys.com
RESEND_FROM_NAME=Gradelys

# ── SEARCH (live web search in chat) ────────────────────────────
SERPER_API_KEY=

# ── APP ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=change-me-in-production
ADMIN_SECRET_KEY=change-me-in-production
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SENTRY_DSN=
